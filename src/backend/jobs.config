{
  "jobs": [
    {
      "functionLocation": "backend/pinger.js",
      "functionName": "dailySelfHit",
      "description": "Ping endpoints every 4 hours",
      "executionConfig": { "cronExpression": "0 */4 * * *" }
    },
    {
      "functionLocation": "backend/seo-sweep.js",
      "functionName": "nightlySeoSweep",
      "description": "Repair products and blog posts whose SEO is missing or still template filler",
      "executionConfig": { "cronExpression": "40 19 * * *" }
    }
  ]
}
